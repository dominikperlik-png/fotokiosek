<?xml version="1.0" encoding="utf-8"?>
<!--
  Důvěryhodné certifikáty pro HTTPS:
  - systémové (jako dosud),
  - navíc ISRG Root X1 (Let's Encrypt): Android 7.0 ho nezná, takže by na automatu s Androidem 7.0
    nefungovalo spojení s webovým účetnictvím na serveru s certifikátem Let's Encrypt.
    Soubor res/raw/isrg_root_x1.pem = https://letsencrypt.org/certs/isrgrootx1.pem,
    SHA-256 96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6.
  cleartextTrafficPermitted = jako dřívější usesCleartextTraffic="true" (IPP tisk na tiskárny přes http://).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
